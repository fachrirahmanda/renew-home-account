{
  "name": "renew-home-account",
  "type": "webpack",
  "main": "src/worker/index.ts",
  "site": {
    "bucket": "./dist"
  },
  "build": {
    "command": "npm run build",
    "cwd": "./",
    "watch_paths": ["src/**/*.ts", "src/**/*.tsx"]
  },
  "env": {
    "production": {
      "name": "renew-home-account-prod",
      "routes": [
        {
          "pattern": "*.example.com/*",
          "zone_name": "example.com"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renew-home-account",
      "database_id": "local"
    }
  ],
  "observability": {
    "enabled": false
  }
}
